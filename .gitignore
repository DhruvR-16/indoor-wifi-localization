.DS_Store
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# UJIIndoorLoc raw and generated processed scans stay local.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Keep reproducible folds and report-facing results under version control.
!data/splits/folds.json

# DAE encoder checkpoints are large binaries and are regenerated
# deterministically by scripts/train_m2_dae.py for a given fold and seed.
results/phase2/m2/dae/*.pt
results/phase2/m2/logs/

# The 180 per-run M2 prediction CSVs are ~75 MB and are regenerated
# deterministically by the A4/A7/A8 runners. The tracked archive
# results/phase2/m2/m2_oof_predictions.csv.gz holds the same rows at full
# precision; scripts/export_m2_oof_predictions.py --restore rebuilds this
# directory from it byte-for-byte.
results/phase2/m2/preds/
